      "name": "On Any Workflow Error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -384,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst wfName = e.workflow?.name || 'unknown';\nconst node = e.execution?.lastNodeExecuted || '?';\nconst msg = e.execution?.error?.message || 'no message';\nreturn [{ json: { ts: $now.toISO(), workflow: wfName, status: 'ERROR', detail: `node: ${node} | ${msg}`.slice(0, 400), url: e.execution?.url || '' } }];"
      },
