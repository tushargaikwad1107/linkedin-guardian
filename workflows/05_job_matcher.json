      },
      "id": "611aa704-fd76-4212-b7eb-fcc9d0cbd61b",
      "name": "Gemini Flash",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1136,
        384
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"skills_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 40\n    },\n    \"domain_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 20\n    },\n    \"verdict\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"strong\",\n        \"possible\",\n        \"stretch\",\n        \"skip\"\n      ]\n    },\n    \"top_skills\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"maxItems\": 3\n    },\n    \"gaps\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"maxItems\": 3\n    },\n    \"cv_angle\": {\n      \"type\": \"string\"\n    },\n    \"talking_points\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"maxItems\": 3\n    },\n    \"cv_keywords\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"maxItems\": 6\n    }\n  },\n  \"required\": [\n    \"skills_score\",\n    \"domain_score\",\n    \"verdict\",\n    \"top_skills\",\n    \"gaps\",\n    \"cv_angle\",\n    \"talking_points\",\n    \"cv_keywords\"\n  ]\n}"
      },
      "id": "4d0744dc-0643-43c9-bdfe-8967917ac56d",
      "name": "Fit JSON Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1264,
        384
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $('Build Fit Prompt').first().json;\nconst o = $json.output || {};\nconst clamp = (v, max) => Math.max(0, Math.min(max, Number(v) || 0));\nconst score = row.location_pts + row.seniority_pts + clamp(o.skills_score, 40) + clamp(o.domain_score, 20);\nreturn { json: {\n  job_id: row.job_id,\n  fit_score: score,\n  score_breakdown: `loc ${row.location_pts} + seniority ${row.seniority_pts} + skills ${clamp(o.skills_score, 40)} + domain ${clamp(o.domain_score, 20)}`,\n  verdict: o.verdict || 'unknown',\n  top_skills: (o.top_skills || []).join(', '),\n  gaps: (o.gaps || []).join(', '),\n  cv_keywords: (o.cv_keywords || []).join(', '),\n  cv_angle: o.cv_angle || '',\n  talking_points: (o.talking_points || []).map((t, i) => `${i + 1}. ${t}`).join('\\n'),\n  status: score >= 60 ? 'matched' : 'skipped',\n  matched_at: $now.toISO()\n} };"
      },
