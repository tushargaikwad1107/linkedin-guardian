    {
      "parameters": {
        "jsCode": "// collect a node's items across every loop iteration\nfunction allRuns(name) {\n  const out = [];\n  for (let r = 0; r < 500; r++) {\n    let items;\n    try { items = $(name).all(0, r); } catch (e) { break; }\n    if (!items || !items.length) break;\n    out.push(...items.map(i => i.json));\n  }\n  return out;\n}\nconst MIN = 75;   // Slack threshold\nconst rows = allRuns('Merge Score');\nconst strong = rows.filter(r => r.fit_score >= MIN).sort((a, b) => b.fit_score - a.fit_score);\nif (!strong.length) return [];   // nothing strong -> no Slack message at all\n\nconst byId = Object.fromEntries($('Read New Jobs').all().map(i => [i.json.job_id, i.json]));\nconst lines = strong.map(r => {\n  const j = byId[r.job_id] || {};\n  return `*${r.fit_score}* | ${j.title} @ ${j.company} (${j.location})\\n${r.cv_angle}\\nAdd to CV: ${r.cv_keywords || '-'}\\nGaps: ${r.gaps || 'none'}\\n<${j.url}|Open job>`;\n});\nreturn [{ json: { message: `:dart: ${strong.length} strong fit(s) found\\n\\n` + lines.join('\\n\\n') } }];"
      },
