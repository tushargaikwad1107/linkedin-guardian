        "text": "=🚀 *Posted to LinkedIn* `{{ $('Image Decision').first().json.post_id }}` {{ $('Image Decision').first().json.has_image ? 'with image 🖼' : '(text only)' }}\n\n{{ $('Pick One Approved Post').first().json.draft.slice(0, 300) }}...",
        "otherOptions": {}
