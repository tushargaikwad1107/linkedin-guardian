            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "ContentQueue",
          "mode": "name"
        },
        "options": {}
      },
      "name": "Read ContentQueue",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pick the first Approved post, but never post more than once per 20 hours\nconst rows = $input.all().map(i => i.json).filter(r => r.post_id);\nconst low = s => String(s || '').trim().toLowerCase();\nconst parse = v => Date.parse(String(v || '').trim().replace(' ', 'T'));\nconst lastPosted = rows.map(r => parse(r.posted_at)).filter(t => !isNaN(t)).sort((a, b) => b - a)[0];\nif (lastPosted && (Date.now() - lastPosted) / 36e5 < 20) return [];   // 20h safety cap\nconst row = rows.find(r => low(r.status) === 'approved' && String(r.draft || '').trim());\nif (!row) return [];\nreturn [{ json: row }];\n"
      },
      "name": "Pick One Approved Post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "queryString": "={{ $('Pick One Approved Post').first().json.post_id }}",
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "YOUR_GOOGLE_ID-",
            "mode": "id"
          },
          "whatToSearch": "files"
        },
        "limit": 50,
        "options": {}
      },
      "name": "Find Image",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        660,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Decide: too long, post with image, post text-only (after 24h), or stamp approved_at and wait\nconst row = $('Pick One Approved Post').first().json;\nconst draft = String(row.draft || '').trim();\nif (draft.length > 3000) return [{ json: { post_id: row.post_id, action: 'too_long', chars: draft.length } }];\n\nconst files = $input.all().map(i => i.json)\n  .filter(f => f.id && String(f.name || '').includes(row.post_id) && /\\.(png|jpe?g|gif)$/i.test(f.name || ''));\nif (files.length) {\n  return [{ json: { post_id: row.post_id, action: 'image', has_image: true, file_id: files[0].id, image_file: files[0].name } }];\n}\n\nconst t = Date.parse(String(row.approved_at || '').trim().replace(' ', 'T'));\nif (!row.approved_at || isNaN(t)) {\n  // first time we see this approval: start the 24h clock\n  return [{ json: { post_id: row.post_id, action: 'stamp', approved_at: $now.setZone('Europe/Dublin').toISO() } }];\n}\nif ((Date.now() - t) / 36e5 < 24) return [];   // still waiting for the image, check again in 15 min\nreturn [{ json: { post_id: row.post_id, action: 'text', has_image: false, image_file: '' } }];\n"
      },
      "name": "Image Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 4,
        "output": "={{ ['image', 'text', 'stamp', 'too_long'].indexOf($json.action) }}"
      },
      "name": "Route (0 image · 1 text · 2 stamp · 3 too long)",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.file_id }}",
          "mode": "id"
        },
        "options": {
          "binaryPropertyName": "data"
        }
      },
      "name": "Download Image",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1340,
        100
      ]
    },
    {
      "parameters": {
        "person": "",
        "text": "={{ $('Pick One Approved Post').first().json.draft }}",
        "shareMediaCategory": "={{ $('Image Decision').first().json.has_image ? 'IMAGE' : 'NONE' }}",
        "binaryPropertyName": "data",
        "additionalFields": {
          "visibility": "PUBLIC"
        }
      },
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [
        1560,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Mark the row Posted with time, LinkedIn id and image name\nconst d = $('Image Decision').first().json;\nconst res = $input.first().json || {};\nconst urn = res.urn || res.id || res.postId || res['x-restli-id'] || '';\nreturn [{ json: {\n  post_id: d.post_id,\n  status: 'Posted',\n  posted_at: $now.setZone('Europe/Dublin').toISO(),\n  linkedin_post_urn: String(urn),\n  image_file: d.image_file || '',\n} }];\n"
      },
      "name": "Mark Posted",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        200
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_ID",
          "mode": "id"
