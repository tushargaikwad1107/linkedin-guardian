    {
      "parameters": {
        "jsCode": "const t = $('Current Target').first().json;\nconst j = t.job;\nconst d = $json;\nconst spec = !!j.speculative;\nconst search = s => 'https://www.linkedin.com/search/results/people/?keywords=' + encodeURIComponent(s) + '&origin=GLOBAL_SEARCH_HEADER';\nconst family = spec ? 'analytics manager'\n  : /product/i.test(j.title) ? 'product manager'\n  : /(data|analytics|bi\\b|intelligence)/i.test(j.title) ? 'analytics manager' : 'business analysis manager';\nconst best = d.best || {};\nreturn { json: {\n  log_id: `cl-${j.job_id}-${Date.now().toString(36)}`,\n  job_id: j.job_id, company: j.company, role: j.title, job_url: j.url, fit_score: j.fit_score,\n  recruiter_search_url: search(`${j.company} ${spec ? 'talent acquisition' : 'recruiter'}`),\n  manager_search_url: search(`${j.company} ${family}`),\n  use_note: t.use_note,\n  note_draft: best.text || '', note_chars: best.chars || 0,\n  alt_notes: (d.variants || []).slice(1).map(v => v.text).join('\\n---\\n'),\n  lint_flags: (best.flags || []).join('; '),\n  status: 'Pending', created_at: $now.toISO(), sent_at: '', person_name: '', person_url: '',\n  followup_draft: '', followup_status: '', your_feedback: ''\n} };\n"
