    {
      "parameters": {
        "jsCode": "// Evening: Accepted rows get a first-message draft; Sent rows older than 7 days get flagged\nconst low = s => String(s || '').trim().toLowerCase();\nconst rows = $input.all().map(i => i.json).filter(r => r.log_id);\nconst out = [];\nfor (const r of rows) {\n  if (low(r.followup_status)) continue;               // already handled\n  if (low(r.status) === 'accepted') {\n    out.push({ json: { log_id: r.log_id, action: 'accepted',\n      context: { company: r.company, role: r.role, person_name: r.person_name || '[Name]',\n                 earlier_note: r.note_draft, relationship: 'just accepted my connection request' } } });\n  } else if (low(r.status) === 'sent') {\n    const t = Date.parse(String(r.sent_at || '').trim().replace(' ', 'T'));\n    if (!isNaN(t) && (Date.now() - t) / 864e5 >= 7) out.push({ json: { log_id: r.log_id, action: 'stale' } });\n  }\n}\nreturn out.slice(0, 10);\n"
      },
