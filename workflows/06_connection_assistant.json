      "alwaysOutputData": true,
      "executeOnce": true,
      "id": "269c00c0-a483-4536-93db-9b416dcc2b39"
    },
    {
      "parameters": {
        "jsCode": "// EDIT ME\nconst NOTE_BUDGET_PER_MONTH = 3;   // free LinkedIn: check your real limit in the \"Add a note\" dialog\nconst DAILY_CAP = 2;                // human-scale volume\nconst MIN_SCORE = 70, NOTE_SCORE = 80;\nconst SPECULATIVE_PER_DAY = 1;      // Watchlist companies added when fewer than DAILY_CAP jobs qualify\nconst COOLDOWN_DAYS = 30;           // never the same company twice within this window\n\nconst low = s => String(s || '').trim().toLowerCase();\nconst logs = $('Read ConnectionLog').all().map(i => i.json).filter(r => r.log_id);\nconst month = new Date().toISOString().slice(0, 7);\nconst notesUsed = logs.filter(r => low(r.use_note) === 'yes'\n  && ['sent', 'accepted'].includes(low(r.status))\n  && String(r.sent_at || '').startsWith(month)).length;\nlet notesLeft = Math.max(0, NOTE_BUDGET_PER_MONTH - notesUsed);\nconst already = new Set(logs.map(r => r.job_id));\n\n// 1. Strong job matches first\nconst jobs = $('Read Matched Jobs').all().map(i => i.json)\n  .filter(j => j.job_id && Number(j.fit_score) >= MIN_SCORE && !j.outreach_status && !already.has(j.job_id))\n  .sort((a, b) => Number(b.fit_score) - Number(a.fit_score))\n  .slice(0, DAILY_CAP);\n\nconst out = jobs.map(j => {\n  const useNote = notesLeft > 0 && Number(j.fit_score) >= NOTE_SCORE;\n  if (useNote) notesLeft--;\n  return { json: { job: j, use_note: useNote ? 'yes' : 'no',\n    context: { company: j.company, role: j.title, location: j.location, why_ttg_fits: j.cv_angle, ttg_top_skills: j.top_skills,\n               job_url: j.url, relationship: 'recruiter or hiring manager for this role, not connected yet' } } };\n});\n\n// 2. Free slot? Add a Watchlist company (speculative outreach, no open role needed)\nif (out.length < DAILY_CAP) {\n  const rank = { high: 0, medium: 1, low: 2 };\n  const todayCompanies = new Set(jobs.map(j => low(j.company)));\n  const lastContact = c => {\n    const ts = logs.filter(r => low(r.company) === low(c)).map(r => Date.parse(r.created_at)).filter(t => !isNaN(t));\n    return ts.length ? Math.max(...ts) : 0;\n  };\n  const cutoff = Date.now() - COOLDOWN_DAYS * 864e5;\n  const picks = $('Read Watchlist').all().map(i => i.json)\n    .filter(w => w.company && !todayCompanies.has(low(w.company)) && lastContact(w.company) < cutoff)\n    .sort((a, b) => ((rank[low(a.priority)] ?? 3) - (rank[low(b.priority)] ?? 3)) || (lastContact(a.company) - lastContact(b.company)))\n    .slice(0, Math.min(SPECULATIVE_PER_DAY, DAILY_CAP - out.length));\n\n  for (const w of picks) {\n    out.push({ json: {\n      job: { job_id: `wl-${low(w.company).replace(/[^a-z0-9]+/g, '-')}`, company: w.company, title: 'Speculative',\n             location: w.city || 'Ireland', url: w.careers_url || w.linkedin_company_url || '', fit_score: '', speculative: true },\n      use_note: 'no',\n      context: { company: w.company, location: w.city, why_this_company: w.why,\n                 relationship: 'hiring manager for Business Analyst, Data or Product roles at this company. No open role: speculative connection, not connected yet.' } } });\n  }\n}\nreturn out;\n"
      },
