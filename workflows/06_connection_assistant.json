        "jsCode": "// One Slack summary after all targets are drafted\nconst t = $(\"Pick Today's Targets\").all().map(i => i.json.job).filter(Boolean);\nif (!t.length) return [];\nconst lines = t.map(j => j.speculative ? `• ${j.company} (speculative, from Watchlist)` : `• ${j.company}: ${j.title} (fit ${j.fit_score})`);\nreturn [{ json: { text: `🤝 *Connection Assistant*: ${t.length} new draft(s) in ConnectionLog\\n${lines.join('\\n')}\\n\\nOpen the search links, find the person, send it yourself, then set status = Sent + sent_at.` } }];\n"
